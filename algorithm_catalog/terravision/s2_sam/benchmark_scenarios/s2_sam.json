        "arguments": {
          "spatial_extent": {
            "west": 5.05,
            "south": 51.21,
            "east": 5.1,
            "north": 51.23
          },
          "temporal_extent": [
            "2025-05-01",
            "2025-05-31"
          ]
        }
      },
      "saveresult1": {
        "process_id": "save_result",
        "arguments": {
          "data": {
            "from_node": "s2sam1"
          },
          "format": "NetCDF",
          "options": {}
        },
        "result": true
      }
    },
    "reference_data": {}
  }
